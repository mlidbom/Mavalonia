<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Mavalonia.MarkdownEditing.Controls"
        xmlns:host="using:Mavalonia.DesktopHost"
        x:Class="Mavalonia.DesktopHost.MainWindow"
        Title="Mavalonia"
        Width="1400" Height="800">
   <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
         <ComboBox x:Name="SampleDocuments" SelectionChanged="OpenSelectedSampleDocument">
            <ComboBox.ItemTemplate>
               <DataTemplate x:DataType="host:SampleDocument">
                  <TextBlock Text="{Binding Name}" />
               </DataTemplate>
            </ComboBox.ItemTemplate>
         </ComboBox>
         <ToggleButton IsChecked="{Binding #Editor.ShowsSource, Mode=TwoWay}" HotKey="Ctrl+M" ToolTip.Tip="Ctrl+M">Source</ToggleButton>
         <Button Click="QuoteWhatIsSelected" HotKey="Ctrl+Shift+E" ToolTip.Tip="Ctrl+Shift+E: quotes in the editor what is selected at the right">Quote</Button>
         <ToggleButton x:Name="IsDark" IsCheckedChanged="ChangeTheTheme">Dark</ToggleButton>
         <TextBlock x:Name="ClickedLink" VerticalAlignment="Center" />
      </StackPanel>
      <Grid ColumnDefinitions="*,*" Margin="8,0,8,8">
         <Border BorderThickness="1" BorderBrush="{DynamicResource TextControlBorderBrush}" CornerRadius="4" Margin="0,0,4,0">
            <controls:MarkdownEditor x:Name="Editor" Padding="12,10" Watermark="Write something" LinkClicked="TellOfTheClickedLink" />
         </Border>
         <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource TextControlBorderBrush}" CornerRadius="4" Margin="4,0,0,0">
            <ScrollViewer>
               <controls:MarkdownView x:Name="View" Padding="12,10" LinkClicked="TellOfTheClickedLink" />
            </ScrollViewer>
         </Border>
      </Grid>
   </DockPanel>
</Window>
