<Project Sdk="Microsoft.NET.Sdk">
   <!-- Everything about markdown that needs no controls: reading it, rendering it and editing it. AvaloniaEdit is here for its TextDocument, which works without a UI: never use a control in this project. -->
   <ItemGroup>
      <PackageReference Include="AngleSharp" />
      <PackageReference Include="Avalonia.AvaloniaEdit" />
      <PackageReference Include="Markdig" />
   </ItemGroup>
   <ItemGroup>
      <InternalsVisibleTo Include="Mavalonia.Markdown.Controls" />
   </ItemGroup>
</Project>
