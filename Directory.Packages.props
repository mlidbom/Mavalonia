<Project>
   <PropertyGroup>
      <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
      <!-- The lowest that the controls work with, so that applications needn't upgrade to use them. -->
      <AvaloniaVersion>12.1.5</AvaloniaVersion>
   </PropertyGroup>
   <ItemGroup>
      <PackageVersion Include="AngleSharp" Version="1.11.0" />
      <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
      <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
      <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
      <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
      <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
      <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
      <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
      <PackageVersion Include="Markdig" Version="1.6.0" />
      <PackageVersion Include="MinVer" Version="8.0.0" />
      <PackageVersion Include="Compze.Must" Version="0.9.2-alpha" />
      <PackageVersion Include="Compze.xUnitBDD" Version="0.8.0-beta" />
      <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.5" />
      <PackageVersion Include="xunit.v3" Version="4.0.3" />
   </ItemGroup>
</Project>
