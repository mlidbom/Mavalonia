<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mavalonia.MarkdownEditing.Controls"
             x:Class="Mavalonia.MarkdownEditing.Controls.MarkdownEditor">
   <TextBox Text="{Binding $parent[controls:MarkdownEditor].Markdown, Mode=TwoWay}"
            AcceptsReturn="True"
            TextWrapping="Wrap" />
</UserControl>
