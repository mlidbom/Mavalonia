<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Mavalonia.MarkdownEditing.Controls"
        xmlns:host="using:Mavalonia.DesktopHost"
        x:Class="Mavalonia.DesktopHost.MainWindow"
        Title="Mavalonia"
        Width="1000" Height="700">
   <DockPanel>
      <ComboBox x:Name="SampleDocuments"
                DockPanel.Dock="Top"
                Margin="8"
                HorizontalAlignment="Left"
                SelectionChanged="OpenSelectedSampleDocument">
         <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="host:SampleDocument">
               <TextBlock Text="{Binding Name}" />
            </DataTemplate>
         </ComboBox.ItemTemplate>
      </ComboBox>
      <controls:MarkdownEditor x:Name="Editor" Margin="8,0,8,8" />
   </DockPanel>
</Window>
